{
  "name": "dsh-super-research",
  "version": "0.0.1",
  "description": "A DSH-native Super Research preset and session research workbench.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.16"
  },
  "exports": {
    ".": "./src/index.js",
    "./preset": "./src/preset.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "src",
    "client",
    "presets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.js",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-instructions": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-tool-presentation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-bash": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-pwsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-web": "0.2.1-rc.2",
    "esbuild": "^0.25.12",
    "js-yaml": "^4.1.0",
    "playwright-core": "^1.60.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-config-editor": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtlexYoung/dsh-super-research.git"
  },
  "homepage": "https://github.com/ArtlexYoung/dsh-super-research#readme",
  "bugs": {
    "url": "https://github.com/ArtlexYoung/dsh-super-research/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
